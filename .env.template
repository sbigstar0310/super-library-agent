# Copy to .env and fill in. The run scripts source ./.env automatically.
# Only the first block is required to generate; the rest are needed to evaluate.

# ============================================================================
# Coding backbone — OpenRouter. Every arm uses deepseek/deepseek-v4-flash.
# Also grades PaperBench (eval/paperbench_eval.py).
# ============================================================================
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=""

# ============================================================================
# OpenAI-compatible endpoint. Three uses: the per-chunk NL summaries the
# default candidate retriever builds (gpt-5.4-nano), code embeddings for the
# Ward strategy, and the gpt-5-mini parser PaperBench grading requires.
# ============================================================================
OPENAILIKE_API_KEY=""
OPENAILIKE_BASE_URL=""

# ============================================================================
# VLM for WebGen appearance grading. Set whichever family you serve; the
# grader falls back to OPENAILIKE_*, then to OPENAI_* .
# ============================================================================
OPENAILIKE_VLM_API_KEY=""
OPENAILIKE_VLM_BASE_URL=""
# ANTHROPIC_VLM_API_KEY=""
# ANTHROPIC_API_KEY=""           # fallback for the line above
# ANTHROPIC_BASE_URL=""           # note: not ANTHROPIC_VLM_BASE_URL

# ============================================================================
# WebGen UI test. Optional: falls back to OPENAILIKE_VLM_*, then OPENAILIKE_*,
# then OPENAI_*. Set these only to point the UI driver somewhere else.
# The model defaults to gpt-5-mini, which is what the paper used.
# ============================================================================
# WEBVOYAGER_API_KEY=""
# WEBVOYAGER_API_BASE=""
# WEBVOYAGER_API_MODEL="gpt-5-mini"
# WEBVOYAGER_REASONING_EFFORT="high"
# WEBVOYAGER_MAX_ITER=""

# ============================================================================
# Hugging Face — forwarded into the agent container (PaperBench).
# ============================================================================
HF_TOKEN=""

# ============================================================================
# Optional. Defaults in parentheses; unset is fine.
# ============================================================================
# MDL_BASE_URL=""                    # vLLM endpoint (http://127.0.0.1:8000/v1)
# WEBGEN_APPEARANCE_MODEL=""         # appearance judge (gpt-5-mini)
# WEBGEN_APPEARANCE_REASONING_EFFORT=""
# WEBGEN_ROOT=""                     # WebGen-Bench checkout (data/WebGen-Bench)
# SLA_STRICT_CANDIDATES="1"          # 0 = continue when the NL index is missing
# WEBGEN_INJECT_NEIGHBORS="1"        # 0 = drop call-graph context from migration
# WEBGEN_LOCAL_EXTRACT="1"           # 0 = skip the local-extract phase
# PAPERBENCH_LOCAL_EXTRACT="1"
# WEBGEN_APPLY_CARRY_FORWARD="0"     # 1 = resume each app's apply from its
#                                    #     prior-round trajectory. This is the
#                                    #     carry-forward arm of appendix F.2.
# CCC_CHUNK_SIZE=""                  # cocoindex chunker
# CCC_MIN_CHUNK_SIZE=""
# CCC_CHUNK_OVERLAP=""
# OPENAI_API_KEY=""                  # last-resort fallback for the two blocks above
# OPENAI_BASE_URL=""
